@model inventory___sales_management_system.Models.Category

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Category Details";
}

<div class="container-fluid">
    <h2 class="mb-4 text-primary font-weight-bold">Category Details</h2>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-folder-open mr-2"></i> Category Info
            </h6>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="text-muted">Name</label>
                    <div class="font-weight-bold text-dark">
                        @Html.DisplayFor(m => m.Name)
                    </div>
                </div>
            </div>

            <div class="mt-4">
                @Html.ActionLink("Edit", "Edit", new { id = Model.CategoryId }, new { @class = "btn btn-primary mr-2" })
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
            </div>
        </div>
    </div>
</div>

@model IEnumerable<inventory___sales_management_system.Models.Category>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "All Categories";
}

<style>
    th.actions-column, td.actions-column {
        width: 150px; 
        white-space: nowrap; 
        text-align: center;
    }

    .clickable-row {
        cursor: pointer;
    }

    .clickable-row:hover {
    background-color: #f2f2f2;
    }

</style>

<h2 class="mb-4 text-primary" style="font-weight: bold">Categories</h2>


<div class="d-flex justify-content-evenly mb-3">
    <a href="@Url.Action("Create", "Categories")" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> New Category
    </a>
</div>


<table class="table">
    <tr>
        <th>
            <a href="@Url.Action("Index", new {
                    sortBy = "Name",
                    sortOrder = ViewBag.SortBy == "Name" && ViewBag.SortOrder == "asc" ? "desc" : "asc",
                    page = 1
                })">
                @Html.DisplayNameFor(model => model.First().Name)
                @(ViewBag.SortBy == "Name"
                ? (ViewBag.SortOrder == "asc" ? " ▲" : " ▼")
                : "")
            </a>
        </th>
        <th class="actions-column">Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr class="clickable-row" data-url="@Url.Action("Details", "Categories", new { id = item.CategoryId })">
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>

            <td class="actions-column">
                <div style="display: flex; gap: 10px; align-items: center; justify-content: center">

                    <a href="@Url.Action("Edit", "Categories", new { id = item.CategoryId })"style="color: #4e73df" title="Edit">
                        <i class="fas fa-edit"></i>
                    </a>

                    @using (Html.BeginForm("Delete", "Categories", new { id = item.CategoryId }, FormMethod.Post, new { onsubmit = "return confirmDelete();" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" style="color: #dc3545; border: none; background: none" title="Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    }

                </div>
            </td>
        </tr>
    }

</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, sortOrder = ViewBag.SortOrder })">@i</a>
                </li>
            }
        </ul>
    </nav>
}


@section Scripts
{
    <script>
        
        function confirmDelete() {
            return confirm('Are you sure you want to delete this category? This will disassociate products but not delete them.');
        }

        $(document).ready(function () {
            $('.clickable-row').on('click', function (e) {
                
                if (!$(e.target).is('a, button, i')) {
                    window.location = $(this).data('url');
                }
            });

            var message = '@TempData["DeleteMessage"]';
            if (message) {
                toastr.success(message);
            }
        });
    </script>
}

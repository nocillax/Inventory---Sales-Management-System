@model IEnumerable<inventory___sales_management_system.Models.Category>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "All Categories";
}

<style>
    th.actions-column, td.actions-column {
        width: 150px; /* or desired fixed width */
        white-space: nowrap; /* prevent wrapping */
        text-align: center;
    }
</style>

<h2 class="mb-4 text-primary" style="font-weight: bold">Categories</h2>


<p>
    @Html.ActionLink("Add Category", "Create", null, new { @class = "btn btn-primary" })
</p>


<table class="table ">
    <tr>
        <th>
            <a href="@Url.Action("Index", new {
                    sortBy = "Name",
                    sortOrder = ViewBag.SortBy == "Name" && ViewBag.SortOrder == "asc" ? "desc" : "asc",
                    page = 1
                })">
                    @Html.DisplayNameFor(model => model.First().Name)
                    @(ViewBag.SortBy == "Name"
                ? (ViewBag.SortOrder == "asc" ? " ▲" : " ▼")
                : "")
            </a>
        </th>
        <th class="actions-column">Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td class="actions-column">
                <div style="display: flex; gap: 10px; align-items: center; justify-content: flex-end">
                    @Html.ActionLink("Edit", "Edit", new { id = item.CategoryId }) |
                    @Html.ActionLink("Details", "Details", new { id = item.CategoryId }) |
                    @using (Html.BeginForm("Delete", "Categories", new { id = item.CategoryId }, FormMethod.Post, new { onsubmit = "return confirmDelete();" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link p-0 align-baseline" style="color: #dc3545;">
                            Delete
                        </button>
                    }

                </div>
            </td>
        </tr>
    }

</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, sortOrder = ViewBag.SortOrder })">@i</a>
                </li>
            }
        </ul>
    </nav>
}


@section  Scripts
{
    <script>
    function confirmDelete() {
        return confirm('Are you sure you want to delete this category? This will disassociate products but not delete them.');
    }

    $(function () {
        var message = '@TempData["DeleteMessage"]';
        if (message) {
            toastr.success(message);
        }
    });
    </script>
}
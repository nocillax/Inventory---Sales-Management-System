@model inventory___sales_management_system.Models.Product

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product Details";
    var role = Session["UserRole"] as string;
}

<div class="container-fluid">
    <h2 class="mb-4 text-primary" style="font-weight: bold">Product Details</h2>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-box-open mr-2"></i> Product Info
                </h6>
            </div>
            @if (role == "Manager")
            {
                <div>
                    <a href="@Url.Action("Edit", new { id = Model.ProductId })" class="btn btn-sm btn-outline-primary mr-2">
                        <i class="fas fa-edit mr-1"></i> Edit
                    </a>

                    <a href="@Url.Action("StockHistory", "Products", new { productId = Model.ProductId })" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-history mr-1"></i> Stock History
                    </a>
                </div>
            }
        </div>
        <div class="card-body">

            <!-- Product Title -->
            <div class="mb-4">
                <h4 class="text-dark font-weight-bold mb-1">@Html.DisplayFor(m => m.Name)</h4>
                <p class="text-muted mb-0">Category: <strong>@Html.DisplayFor(m => m.Category.Name)</strong></p>
            </div>

            <!-- Pricing Card -->
            <div class="card mb-4">
                <div class="card-header bg-white border-bottom">
                    <h6 class="font-weight-bold text-secondary mb-0">Pricing</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="text-muted">Price</label>
                            <div class="font-weight-bold">@Model.Price.ToString("C")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Cost per Unit</label>
                            <div class="font-weight-bold">@Model.Cost.ToString("C")</div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Discount (%)</label>
                            <div class="font-weight-bold">@Model.DiscountPercent</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Inventory Card -->
            <div class="card mb-4">
                <div class="card-header bg-white border-bottom">
                    <h6 class="font-weight-bold text-secondary mb-0">Inventory</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="text-muted">Quantity Available</label>
                            <div class="font-weight-bold">@Model.QuantityAvailable</div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Low Stock Threshold</label>
                            <div class="font-weight-bold">@Model.LowStockThreshold</div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Last Edited</label>
                            <div class="font-weight-bold">@Model.DateEdited.ToString("g")</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Card -->
            <div class="card mb-4">
                <div class="card-header bg-white border-bottom">
                    <h6 class="font-weight-bold text-secondary mb-0">Status</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label class="text-muted">On Sale</label>
                            <div class="font-weight-bold text-dark">
                                @(Model.IsOnSale ? "Yes" : "No")
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="text-muted">Active</label>
                            <div class="font-weight-bold text-dark">
                                @(Model.IsActive ? "Yes" : "No")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="mt-5">

                @if (role == "Manager")
                {
                    <a href="@Url.Action("AddStock", "Products", new { productId = Model.ProductId })" class="btn btn-primary mr-2">
                        <i class="fas fa-plus-circle mr-1"></i> Add Stock
                    </a>
                }

                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>

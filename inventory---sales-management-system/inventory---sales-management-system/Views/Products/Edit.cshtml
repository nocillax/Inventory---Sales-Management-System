@model inventory___sales_management_system.ViewModels.Product.EditProductViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Edit Product";
}

<div class="container-fluid">
    <h2 class="mb-4 text-primary" style="font-weight: bold">Edit Product</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-box-open mr-2"></i> Edit Information
                </h6>
            </div>
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.ProductId)

                <!-- Basic Info -->
                <div class="card mb-4">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="font-weight-bold text-secondary mb-0">Basic Info</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.Name, "Product Name")
                                @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.CategoryId, "Category")
                                @Html.DropDownListFor(m => m.CategoryId, Model.Categories, "-- Select Category --", new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pricing -->
                <div class="card mb-4">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="font-weight-bold text-secondary mb-0">Pricing</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                @Html.LabelFor(m => m.Price)
                                @Html.EditorFor(m => m.Price, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-4">
                                @Html.LabelFor(m => m.Cost, "Cost per Unit")
                                @Html.EditorFor(m => m.Cost, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(m => m.Cost, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-4">
                                @Html.LabelFor(m => m.DiscountPercent, "Discount (%)")
                                @Html.EditorFor(m => m.DiscountPercent, new { htmlAttributes = new { @class = "form-control", type = "number", min = 0, max = 100, step = "0.01" } })
                                @Html.ValidationMessageFor(m => m.DiscountPercent, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Inventory -->
                <div class="card mb-4">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="font-weight-bold text-secondary mb-0">Inventory</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.QuantityAvailable, "Quantity Available")
                                @Html.EditorFor(m => m.QuantityAvailable, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(m => m.QuantityAvailable, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group col-md-6">
                                @Html.LabelFor(m => m.LowStockThreshold)
                                @Html.EditorFor(m => m.LowStockThreshold, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(m => m.LowStockThreshold, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Status -->
                <div class="card mb-4">
                    <div class="card-header bg-white border-bottom">
                        <h6 class="font-weight-bold text-secondary mb-0">Status</h6>
                    </div>
                    <div class="card-body">
                        <div class="form-row">
                            <div class="form-group col-md-3">
                                <div class="form-check mt-2">
                                    @Html.CheckBoxFor(m => m.IsOnSale, new { @class = "form-check-input" })
                                    @Html.LabelFor(m => m.IsOnSale, new { @class = "form-check-label" })
                                </div>
                            </div>
                            <div class="form-group col-md-3">
                                <div class="form-check mt-2">
                                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                                    @Html.LabelFor(m => m.IsActive, "Active", new { @class = "form-check-label" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-1"></i> Save
                    </button>
                    @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary ml-2" })
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

@model IEnumerable<inventory___sales_management_system.Models.Product>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Index";
    var role = Session["UserRole"]?.ToString();

    Func<string, string> arrow = column =>
        ViewBag.SortBy == column ? (ViewBag.SortOrder == "asc" ? " ▲" : " ▼") : "";
    string toggleSort(string column) =>
        ViewBag.SortBy == column && ViewBag.SortOrder == "asc" ? "desc" : "asc";
}

<style>
    th.actions-column, td.actions-column {
        width: 150px;
        white-space: nowrap;
        text-align: center;
    }

    .clickable-row {
        cursor: pointer;
    }

    .clickable-row:hover {
            background-color: #f2f2f2;
    }
</style>

<h2 class="mb-4 text-primary" style="font-weight: bold">All Products</h2>

@if (role == "Manager")
{

    <div class="d-flex justify-content-evenly mb-3">
        <a href="@Url.Action("Create", "Products")" class="btn btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm text-white-50"></i> New Product
        </a>
    </div>
}

@using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "form-inline mb-3" }))
{
    <div class="d-flex flex-wrap justify-content-between w-100 gap-3">

        @if (role == "Manager")
        {
            <div class="flex-grow-1">
                <label class="form-label d-block">Active:</label>
                <select name="isActiveFilter" class="form-control" onchange="this.form.submit()">
                    <option value="">All</option>
                    <option value="true" @(ViewBag.IsActiveFilter == "true" ? "selected" : "")>Active</option>
                    <option value="false" @(ViewBag.IsActiveFilter == "false" ? "selected" : "")>Inactive</option>
                </select>
            </div>
        }


        <div class="flex-grow-1">
            <label class="form-label d-block">Sale:</label>
            <select name="onSaleFilter" class="form-control" onchange="this.form.submit()">
                <option value="">All</option>
                <option value="true" @(ViewBag.OnSaleFilter == "true" ? "selected" : "")>On Sale</option>
                <option value="false" @(ViewBag.OnSaleFilter == "false" ? "selected" : "")>Not On Sale</option>
            </select>
        </div>

        <div class="flex-grow-1">
            <label class="form-label d-block">Price Range:</label>
            <div class="d-flex align-items-center">
                <input type="number" name="minPrice" class="form-control" placeholder="Min" value="@ViewBag.MinPrice" style="width: 100px;" />
                <span class="mx-2">–</span>
                <input type="number" name="maxPrice" class="form-control" placeholder="Max" value="@ViewBag.MaxPrice" style="width: 100px;" />
                <button type="submit" class="btn btn-primary ml-2"><i class="fas fa-filter"></i></button>
            </div>
        </div>

        <div class="flex-grow-1">
            <label class="form-label d-block">Category:</label>
            @Html.DropDownList("categoryFilter", (SelectList)ViewBag.Categories, "All Categories", new
            {
                @class = "form-control select2",
                onchange = "this.form.submit();"
            })
        </div>
    </div>



    <input type="hidden" name="sortBy" value="@ViewBag.SortBy" />
    <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />

}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary()
    </div>
}

<table class="table mt-4">
    <tr>
        <th>
            <a href="@Url.Action("Index", new {
                        sortBy = "Category", sortOrder = toggleSort("Category"),
                        page = 1,
                        isActiveFilter = ViewBag.IsActiveFilter,
                        onSaleFilter = ViewBag.OnSaleFilter,
                        minPrice = ViewBag.MinPrice,
                        maxPrice = ViewBag.MaxPrice,
                        categoryFilter = ViewBag.CategoryFilter
                    })">
                Category @Html.Raw(arrow("Category"))
            </a>
        </th>
        <th>
            <a href="@Url.Action("Index", new {
                        sortBy = "Name", sortOrder = toggleSort("Name"),
                        page = 1,
                        isActiveFilter = ViewBag.IsActiveFilter,
                        onSaleFilter = ViewBag.OnSaleFilter,
                        minPrice = ViewBag.MinPrice,
                        maxPrice = ViewBag.MaxPrice,
                        categoryFilter = ViewBag.CategoryFilter
                    })">
                Product @Html.Raw(arrow("Name"))
            </a>
        </th>
        <th>
            <a href="@Url.Action("Index", new {
                        sortBy = "Price", sortOrder = toggleSort("Price"),
                        page = 1,
                        isActiveFilter = ViewBag.IsActiveFilter,
                        onSaleFilter = ViewBag.OnSaleFilter,
                        minPrice = ViewBag.MinPrice,
                        maxPrice = ViewBag.MaxPrice,
                        categoryFilter = ViewBag.CategoryFilter
                    })">
                Price @Html.Raw(arrow("Price"))
            </a>
        </th>
        <th>
            <a href="@Url.Action("Index", new {
                        sortBy = "Discount", sortOrder = toggleSort("Discount"),
                        page = 1,
                        isActiveFilter = ViewBag.IsActiveFilter,
                        onSaleFilter = ViewBag.OnSaleFilter,
                        minPrice = ViewBag.MinPrice,
                        maxPrice = ViewBag.MaxPrice,
                        categoryFilter = ViewBag.CategoryFilter
                    })">
                Discount (%) @Html.Raw(arrow("Discount"))
            </a>
        </th>
        <th>
            <a href="@Url.Action("Index", new {
                        sortBy = "Quantity", sortOrder = toggleSort("Quantity"),
                        page = 1,
                        isActiveFilter = ViewBag.IsActiveFilter,
                        onSaleFilter = ViewBag.OnSaleFilter,
                        minPrice = ViewBag.MinPrice,
                        maxPrice = ViewBag.MaxPrice,
                        categoryFilter = ViewBag.CategoryFilter
                    })">
                Quantity @Html.Raw(arrow("Quantity"))
            </a>
        </th>


        @if (role == "Manager")
        {
            <th style="text-align:center">
                <a href="@Url.Action("Index", new {
                        sortBy = "Status", sortOrder = toggleSort("Status"),
                        page = 1,
                        isActiveFilter = ViewBag.IsActiveFilter,
                        onSaleFilter = ViewBag.OnSaleFilter,
                        minPrice = ViewBag.MinPrice,
                        maxPrice = ViewBag.MaxPrice,
                        categoryFilter = ViewBag.CategoryFilter
                    })">
                    Status @Html.Raw(arrow("Status"))
                </a>
            </th>

            <th class="actions-column">Actions</th>
        }
    </tr>

    @foreach (var item in Model)
    {
        <tr class="clickable-row" data-url="@Url.Action("Details", "Products", new { id = item.ProductId })">
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>

            <td>
                @(item.DiscountPercent.HasValue ? item.DiscountPercent.Value.ToString("F2") : "-")
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.QuantityAvailable)
            </td>


            @if (role == "Manager")
            {
                <td style="text-align: center;">
                    <a href="#" class="toggle-status" data-id="@item.ProductId" title="Toggle Status">
                        <i class="fas @(item.IsActive ? "fa-toggle-on" : "fa-toggle-off")"
                           style="color:@(item.IsActive ? "green" : "gray"); font-size: 1.5rem;"></i>
                    </a>
                </td>


                <td class="actions-column">
                    <div style="display: flex; gap: 10px; align-items: center; justify-content: center">

                        <a href="@Url.Action("Edit", "Products", new { id = item.ProductId })" style="color: #4e73df" title="Edit">
                            <i class="fas fa-edit"></i>
                        </a>

                        @using (Html.BeginForm("Delete", "Products", new { id = item.ProductId }, FormMethod.Post, new { onsubmit = "return confirmDelete();" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" style="color: #dc3545; border: none; background: none" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        }

                    </div>
                </td>
            }

        </tr>
    }

</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        page = i,
                        sortBy = ViewBag.SortBy,
                        sortOrder = ViewBag.SortOrder,
                        isActiveFilter = ViewBag.IsActiveFilter,
                        onSaleFilter = ViewBag.OnSaleFilter,
                        minPrice = ViewBag.MinPrice,
                        maxPrice = ViewBag.MaxPrice,
                        categoryFilter = ViewBag.CategoryFilter
                    })">@i</a>
                </li>
            }
        </ul>
    </nav>
}



@section Scripts {
    <script>
    function confirmDelete() {
        return confirm('Are you sure you want to delete this product?');
    }

    $(function () {
        $('.clickable-row').on('click', function (e) {
            if (!$(e.target).is('a, button, i')) {
                window.location = $(this).data('url');
            }
        });

        $('.toggle-status').click(function (e) {
            e.stopPropagation();
            e.preventDefault();

            const $icon = $(this).find('i');
            const productId = $(this).data('id');

            $.post('@Url.Action("ToggleActiveStatus", "Products")', { id: productId }, function (isActive) {
                $icon
                    .toggleClass('fa-toggle-on', isActive)
                    .toggleClass('fa-toggle-off', !isActive)
                    .css('color', isActive ? 'green' : 'gray');
            }).fail(function () {
                alert("Failed to toggle status.");
            });
        });

        var success = '@TempData["ProductSuccessMessage"]';
        var deleted = '@TempData["ProductDeleteMessage"]';

        if (success) {
            toastr.success(success);
        }
        if (deleted) {
            toastr.success(deleted);
        }
    });
    </script>

}

@model IEnumerable<inventory___sales_management_system.Models.Product>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Index";
    var role = Session["UserRole"]?.ToString();
}

<h2>Index</h2>

@if (role == "Manager")
{
    <p>
        @Html.ActionLink("Create New Product", "Create")
    </p>
}
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Category.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Price)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.QuantityAvailable)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DateEdited)
        </th>
        @if (role == "Manager")
        {
            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>
            <th>
            </th>
        }
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QuantityAvailable)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateEdited)
            </td>
            @if (role == "Manager")
            {
                <td>
                    @Html.DisplayFor(modelItem => item.IsActive)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.ProductId }) |
                    @Html.ActionLink("Details", "Details", new { id = item.ProductId }) |
                    @using (Html.BeginForm("Delete", "Products", new { id = item.ProductId }, FormMethod.Post, new { onsubmit = "return confirmDelete();" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    }
                </td>
            }

        </tr>
    }

</table>


@section Scripts {
    <script>
        function confirmDelete() {
            return confirm('Are you sure you want to delete this product?');
        }
        $(function () {
            var message = '@TempData["DeleteMessage"]';
            if (message) {
                toastr.success(message);
            }
        });
    </script>
}
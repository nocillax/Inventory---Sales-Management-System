@model IEnumerable<inventory___sales_management_system.Models.StockEntry>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Stock History";
}

<h2>Stock History for @ViewBag.ProductName</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().DateAdded)</th>
            <th>@Html.DisplayNameFor(model => model.First().Supplier)</th>
            <th>@Html.DisplayNameFor(model => model.First().CostPerQty)</th>
            <th>@Html.DisplayNameFor(model => model.First().QuantityAdded)</th>
            <th>@Html.DisplayNameFor(model => model.First().TotalCost)</th>
            <th>Added By</th> <!-- No Display attribute on User.Username -->
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.DateAdded.ToString("dd MMM yyyy")</td>
                <td>@entry.Supplier</td>
                <td>@entry.CostPerQty.ToString("C")</td>
                <td>@entry.QuantityAdded</td>
                <td>@entry.TotalCost.ToString("C")</td>
                <td>@(entry.User?.Username ?? "N/A")</td>
            </tr>
        }
    </tbody>
</table>

@Html.ActionLink("Back to Product", "Details", "Products", new { id = ViewBag.ProductId }, new { @class = "btn btn-secondary" })

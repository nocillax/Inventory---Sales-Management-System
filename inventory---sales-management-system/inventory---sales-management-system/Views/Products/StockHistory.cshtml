@model IEnumerable<inventory___sales_management_system.ViewModels.Stock.StockHistoryViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productName = ViewBag.ProductName as string;
    var productId = ViewBag.ProductId as int?;
}

@if (productName != null)
{
<h2 class="mb-4 text-primary" style="font-weight: bold">Stock History for @productName</h2>
}
else
{
<h2 class="mb-4 text-primary" style="font-weight: bold">Stock History</h2>
}

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().DateAdded)</th>
            @if (productName == null)
            {
                <th>@Html.DisplayNameFor(model => model.First().ProductName)</th>
            }

            <th>@Html.DisplayNameFor(model => model.First().Supplier)</th>
            <th>@Html.DisplayNameFor(model => model.First().CostPerQty)</th>
            <th>@Html.DisplayNameFor(model => model.First().QuantityAdded)</th>
            <th>@Html.DisplayNameFor(model => model.First().TotalCost)</th>
            <th>@Html.DisplayNameFor(model => model.First().AddedByUsername)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.DateAdded.ToString("dd MMM yyyy")</td>
                @if (productName == null)
                {
                    <td>@entry.ProductName</td>
                }
                <td>@entry.Supplier</td>
                <td>@entry.CostPerQty.ToString("C")</td>
                <td>@entry.QuantityAdded</td>
                <td>@entry.TotalCost.ToString("C")</td>
                <td>@entry.AddedByUsername</td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.ProductId != null)
{
    @Html.ActionLink("Back to Product", "Details", "Products", new { id = ViewBag.ProductId }, new { @class = "btn btn-secondary" })
}


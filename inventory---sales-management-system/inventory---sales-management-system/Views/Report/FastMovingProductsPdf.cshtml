@model List<inventory___sales_management_system.ViewModels.Report.FastMovingProductViewModel>
@{
    Layout = null;
    int month = ViewBag.Month;
    int year = ViewBag.Year;
    string monthName = new DateTime(year, month, 1).ToString("MMMM yyyy");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Fast-Moving Products - @monthName</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            margin: 20px;
        }

        h2 {
            text-align: center;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        th, td {
            border: 1px solid #999;
            padding: 6px;
            text-align: center;
        }

        th {
            background-color: #f2f2f2;
        }

        thead {
            display: table-header-group;
        }

        tbody tr:first-child td {
            padding-top: 10px;
        }
    </style>
</head>
<body>
    <h2>Fast-Moving Products - @monthName</h2>

    <table>
        <thead style="display: table-header-group;">
            <tr>
                <th>Product</th>
                <th>Units/Day</th>
                <th>Quantity Sold</th>
                <th>Days Active</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4">No sales data found for this month.</td></tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.UnitsPerDay.ToString("F2")</td>
                        <td>@item.QuantitySold</td>
                        <td>@item.DaysActive</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</body>
</html>

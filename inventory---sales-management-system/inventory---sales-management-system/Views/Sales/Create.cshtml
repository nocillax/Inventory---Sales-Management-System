@model inventory___sales_management_system.ViewModels.Sale.CreateSaleViewModel

@{
    ViewBag.Title = "Create Sale";
}


    <style>
        .select2-container .select2-selection--single {
            height: 38px !important; /* match Bootstrap .form-control height */
            padding: 6px 12px;
            border: 1px solid #ced4da; /* match Bootstrap border */
            border-radius: 4px;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 24px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default .select2-search--dropdown .select2-search__field {
            border: 1px solid #ced4da; /* lighter border like Bootstrap */
            padding: 6px 10px;
            border-radius: 4px;
            outline: none;
            box-shadow: none;
        }

            .select2-container--default .select2-search--dropdown .select2-search__field:focus {
                border-color: #80bdff;
                box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25); /* mimic Bootstrap focus */
            }
    </style>


<h2>Create Sale</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div>
        @Html.LabelFor(m => m.Date)
        @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-ddTHH:mm}", new { type = "datetime-local", @class = "form-control" })

    </div>

    <div>
        @Html.LabelFor(m => m.BuyerName)
        @Html.TextBoxFor(m => m.BuyerName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.BuyerName)
    </div>

    <hr />

    <div>
        <label for="productSelect">Select Product</label>

        <select id="productSelect" class="form-control select2">
            <option value="">-- Select Product --</option>
            @foreach (var p in Model.ProductsList)
            {
                <option value="@p.ProductId"
                        data-price="@p.Price"
                        data-stock="@p.QuantityAvailable"
                        data-name="@p.Name">
                    @p.Name
                </option>
            }
        </select>


        <label>Quantity</label>
        <input type="number" id="qtyInput" value="1" min="1" class="form-control" style="width: 100px;" />

        <button type="button" id="addProductBtn" class="btn btn-success mt-2">Add Product</button>

    </div>

    <hr />

    <table class="table" id="productsTable" style="display:none;">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Regular Price</th>
                <th>Discount</th>
                <th>Price</th>
                <th>Subtotal</th>

            </tr>
        </thead>
        <tbody>
            <!-- rows added here by JS -->
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" style="text-align:right"><strong>Total:</strong></td>
                <td><span id="totalAmount">0.00</span></td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <input type="submit" value="Create Sale" class="btn btn-primary mt-3" />
}




@section Scripts {
    <script>
        $(document).ready(function () {
            $('#productSelect').select2({
                placeholder: '-- Select Product --',
                allowClear: true,
                templateResult: formatProduct,
                templateSelection: formatProductSelection
            });

            function formatProduct(state) {
                if (!state.id) return state.text;

                const price = $(state.element).data('price');
                const stock = $(state.element).data('stock');
                const name = $(state.element).data('name');

                return $(`
                    <div>
                        <strong>${name}</strong><br/>
                        <small>Price: $${parseFloat(price).toFixed(2)} ; In stock: ${stock}</small>
                    </div>
                `);
            }

            function formatProductSelection(state) {
                if (!state.id) return state.text;

                const name = $(state.element).data('name');
                return name;
            }

        });



        // Product map from server
        const productsData = {
            @foreach (var p in Model.ProductsList)
            {
                <text>
                @p.ProductId: {
                    name: "@p.Name",
                    price: @p.Price,
                    isOnSale: @(p.IsOnSale.ToString().ToLower()),
                    discount: @(p.DiscountPercent ?? 0)
                },
                </text>
            }
        };

        const productsTable = document.getElementById('productsTable');
        const tbody = productsTable.querySelector('tbody');
        const totalAmountSpan = document.getElementById('totalAmount');
        const addedProducts = {};

        document.getElementById('addProductBtn').addEventListener('click', function () {
            const select = productSelect;
            const qtyInput = document.getElementById('qtyInput');
            const productId = select.value;
            const qty = parseInt(qtyInput.value);

            if (!productId) return alert('Please select a product');
            if (isNaN(qty) || qty < 1) return alert('Enter a valid quantity');
            if (addedProducts[productId]) return alert('Product already added');

            const product = productsData[productId];
            const regularPrice = product.price;
            const discount = product.isOnSale ? product.discount : 0;
            const priceAtSale = regularPrice * (1 - discount / 100);
            const subtotal = priceAtSale * qty;

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${product.name}<input type="hidden" name="productIds" value="${productId}" /></td>
                <td><input type="number" name="quantities" value="${qty}" min="1" class="form-control qtyInput" style="width:80px;" /></td>
                <td>${regularPrice.toFixed(2)}</td>
                <td>${discount > 0 ? discount.toFixed(2) + "%" : "-"}</td>
                <td>${priceAtSale.toFixed(2)}</td>
                <td class="subtotal">${subtotal.toFixed(2)}</td>
                <td><button type="button" class="btn btn-link text-danger p-0 removeBtn" title="Remove"><i class="fas fa-times"></i></button></td>
            `;

            tbody.appendChild(tr);
            productsTable.style.display = '';
            addedProducts[productId] = { row: tr, priceAtSale, discount, regularPrice };

            updateTotal();

            // Quantity change handler
            tr.querySelector('.qtyInput').addEventListener('input', function (e) {
                let val = parseInt(e.target.value);
                if (isNaN(val) || val < 1) val = 1;
                e.target.value = val;

                const newSubtotal = val * addedProducts[productId].priceAtSale;
                tr.querySelector('.subtotal').textContent = newSubtotal.toFixed(2);
                updateTotal();
            });

            // Remove button handler
            tr.querySelector('.removeBtn').addEventListener('click', function () {
                tr.remove();
                delete addedProducts[productId];
                if (tbody.children.length === 0) productsTable.style.display = 'none';
                updateTotal();
            });

            // Reset fields
            select.value = '';
            productSearch.value = '';
            qtyInput.value = 1;
        });

        function updateTotal() {
            let total = 0;
            tbody.querySelectorAll('.subtotal').forEach(cell => {
                total += parseFloat(cell.textContent);
            });
            totalAmountSpan.textContent = total.toFixed(2);
        }
    </script>
}







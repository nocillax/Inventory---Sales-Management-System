@model inventory___sales_management_system.ViewModels.Sale.SaleDetailsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Sale Details";
}

<h2 class="mb-4 text-primary" style="font-weight: bold">Sale Details</h2>

<div>
    <h4>Sale Info</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>@Html.DisplayNameFor(m => m.SalesPersonName)</dt>
        <dd>@Html.DisplayFor(m => m.SalesPersonName)</dd>

        <dt>@Html.DisplayNameFor(m => m.Date)</dt>
        <dd>@Html.DisplayFor(m => m.Date)</dd>

        <dt>@Html.DisplayNameFor(m => m.BuyerName)</dt>
        <dd>@Html.DisplayFor(m => m.BuyerName)</dd>
    </dl>
</div>

<h4>Items Sold</h4>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Product Name</th>
            <th>Quantity</th>
            <th>Regular Price</th>
            <th>Discount</th>
            <th>Price</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.SaleItems)
        {
            <tr>
                <td>@(item.ProductName ?? "N/A")</td>
                <td>@item.Quantity</td>
                <td>@item.RegularPrice.ToString("C")</td>
                <td>@(item.DiscountPercent.HasValue ? item.DiscountPercent.Value.ToString("F2") + "%" : "-")</td>
                <td>@item.PriceAtSale.ToString("C")</td>
                <td>@item.Subtotal.ToString("C")</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="5" class="text-right"><strong>Total:</strong></td>
            <td><strong>@Model.TotalAmount.ToString("C")</strong></td>
        </tr>
    </tfoot>
</table>


<div style="display: flex; justify-content:space-between">
    <a class="btn btn-secondary" href="@Url.Action("Index", "Sales")">
        Back to List
    </a>


    <a class="btn btn-success" target="_blank" href="@Url.Action("Invoice", "Sales", new { id = Model.SaleId })">
        <i class="fas fa-file-pdf"></i> Generate Invoice
    </a>
</div>




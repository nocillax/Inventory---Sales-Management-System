@model IEnumerable<inventory___sales_management_system.ViewModels.Sale.SaleHistoryViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Index";
    var role = Session["UserRole"] as String;
}

<h2 class="mb-4 text-primary font-weight-bold">
    @(role == "Manager" ? "Sales History" : "My Sales History")
</h2>


<p>
    @Html.ActionLink("Create New", "Create")
</p>

<form method="get" class="form-inline mb-3">
    <label class="mr-2">From:</label>
    <input type="date" name="startDate" class="form-control mr-3" value="@ViewBag.StartDate" />

    <label class="mr-2">To:</label>
    <input type="date" name="endDate" class="form-control mr-3" value="@ViewBag.EndDate" />

    <button type="submit" class="btn btn-primary">Filter</button>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @Html.ValidationSummary()
    </div>
}


<table class="table">
    <tr>
        <th>
            <a href="@Url.Action("Index", new {
                sortBy = "Date",
                sortOrder = ViewBag.SortBy == "Date" && ViewBag.SortOrder == "asc" ? "desc" : "asc",
                startDate = ViewBag.StartDate,
                endDate = ViewBag.EndDate
            })">
                @Html.DisplayNameFor(model => model.Date)
                @(ViewBag.SortBy == "Date" ? (ViewBag.SortOrder == "asc" ? " ▲" : " ▼") : "")
            </a>
        </th>

        @if (role == "Manager")
        {
            <th>
                @Html.DisplayNameFor(model => model.SalesPersonName)
            </th>
        }

        <th>
            @Html.DisplayNameFor(model => model.BuyerName)
        </th>
        <th>
            <a href="@Url.Action("Index", new {
                sortBy = "TotalAmount",
                sortOrder = ViewBag.SortBy == "TotalAmount" && ViewBag.SortOrder == "asc" ? "desc" : "asc",
                startDate = ViewBag.StartDate,
                endDate = ViewBag.EndDate
            })">
                @Html.DisplayNameFor(model => model.TotalAmount)
                @(ViewBag.SortBy == "TotalAmount" ? (ViewBag.SortOrder == "asc" ? " ▲" : " ▼") : "")
            </a>
        </th>
        <th>
            Action
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>

            @if (role == "Manager")
            {
                <td>
                    @Html.DisplayFor(modelItem => item.SalesPersonName)
                </td>
            }

            <td>
                @Html.DisplayFor(modelItem => item.BuyerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalAmount)
            </td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = item.SaleId })
            </td>
        </tr>
    }

</table>

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        page = i,
                        sortBy = ViewBag.SortBy,
                        sortOrder = ViewBag.SortOrder,
                        startDate = ViewBag.StartDate,
                        endDate = ViewBag.EndDate
                    })">@i</a>
                </li>
            }
        </ul>
    </nav>
}


@section Scripts {
    <script>
        $(function() {
            var saleCreated = '@TempData["SaleCreated"]';
            var saleId = '@TempData["SaleId"]';

            if (saleCreated === 'True') {
                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "timeOut": "10000"
                };

                toastr.success(
                    'Sale created successfully! <br/><button type="button" class="btn btn-sm btn-light" onclick="window.open(\'@Url.Action("Invoice", "Sales")/' + saleId + '\', \'_blank\')">View Invoice</button>',
                    'Success',
                    { timeOut: 0, extendedTimeOut: 0, escapeHtml: false }
                );
            }
        });
    </script>
}

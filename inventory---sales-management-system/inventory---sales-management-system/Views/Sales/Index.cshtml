@model IEnumerable<inventory___sales_management_system.Models.Sale>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Index";
    var role = Session["UserRole"]?.ToString();
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        @if (role == "Manager")
        {
            <th>
                @Html.DisplayNameFor(model => model.User.Username)
            </th>
        }
        <th>
            @Html.DisplayNameFor(model => model.Date)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.BuyerName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TotalAmount)
        </th>
        <th>
            Action
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            @if (role == "Manager")
            {
                <td>
                    @Html.DisplayFor(modelItem => item.User.Username)
                </td>
            }
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BuyerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalAmount)
            </td>
            <td>
                @Html.ActionLink("Details", "Details", new { id = item.SaleId })
            </td>
        </tr>
    }

</table>

@section Scripts {
    <script>
        $(function() {
            var saleCreated = '@TempData["SaleCreated"]';
            var saleId = '@TempData["SaleId"]';

            if (saleCreated === 'True') {
                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "timeOut": "10000"
                };

                toastr.success(
                    'Sale created successfully! <br/><button type="button" class="btn btn-sm btn-light" onclick="window.open(\'@Url.Action("Invoice", "Sales")/' + saleId + '\', \'_blank\')">View Invoice</button>',
                    'Success',
                    { timeOut: 0, extendedTimeOut: 0, escapeHtml: false }
                );
            }
        });
    </script>
}

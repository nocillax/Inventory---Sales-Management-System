                            <a class="collapse-item" href="@Url.Action("MonthlySalesSummary", "Report", new { groupBy = "Category" })">By Category</a>
                            <a class="collapse-item" href="@Url.Action("MonthlySalesSummary", "Report", new { groupBy = "Product" })">By Product</a>
                        </div>
                    </div>
                </li>


    <style>

        #sidebarToggleTop {
            background-color: transparent !important;
            box-shadow: none !important;
            outline: none !important;
            border-radius: 0 !important;
        }

        #sidebarToggleTop:hover,
        #sidebarToggleTop:focus {
            background-color: transparent !important;
            box-shadow: none !important;
            outline: none !important;
        }

        /* Compact the input field */
        #globalSearchInput {
            padding-top: 0.3rem;
            padding-bottom: 0.3rem;
            font-size: 0.85rem;
        }

        #globalSearchDropdown {
            border: 1px solid #dee2e6;
        }

        /* Reduce the placeholder font size */
        #globalSearchInput::placeholder {
            font-size: 0.8rem;
            color: #adb5bd;
        }

        /* Remove thick border and focus ring */
        #globalSearchInput:focus {
            box-shadow: none;
            border-color: #ced4da;
            outline: none;
        }

        /* Style the input group icon */
        .input-group-text {
            font-size: 0.85rem;
            padding: 0.35rem 0.6rem;
            border-radius: 4px 0 0 4px;
        }


        /* limit dropdown height */
        #searchResults {
            max-height: 600px;
            overflow-y: auto;
        }

        /* Style each search section */
        .search-section-card {
            background-color: #fdfdfd;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 6px 10px;
            margin-bottom: 6px;
            box-shadow: 0 1px 1px rgba(0, 0, 0, 0.03);
        }

        .search-section-title {
            font-weight: 600;
            font-size: 0.8rem;
            margin-bottom: 4px;
            color: #495057;
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 2px;
        }

        .search-result-item {
            padding: 4px 6px;
            font-size: 0.8rem;
            transition: background-color 0.15s ease;
            border-radius: 3px;
        }

        .search-result-item:hover {
            background-color: #f1f1f1;
        }

        .search-result-item a {
            text-decoration: none;
            color: #212529;
            display: block;

        }
    </style>


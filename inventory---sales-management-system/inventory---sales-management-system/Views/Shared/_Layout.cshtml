    <script>
        let idleTimer, pingInterval;
        const PING_EVERY_MS = 5 * 60 * 1000; // 5 minutes
        const IDLE_LIMIT_MS = 10 * 60 * 1000; // 10 minutes

        function startPing() {
            if (!pingInterval) {
                pingInterval = setInterval(() => {
                    fetch('/KeepAlive/Ping', {
                        cache: 'no-store',
                        credentials: 'same-origin'
                    });
                }, PING_EVERY_MS);
            }
        }

        function stopPing() {
            clearInterval(pingInterval);
            pingInterval = null;
        }

        function resetIdleTimer() {
            clearTimeout(idleTimer);
            startPing();
            idleTimer = setTimeout(stopPing, IDLE_LIMIT_MS);
        }

        ['mousemove', 'keydown', 'scroll', 'click'].forEach(event =>
            document.addEventListener(event, resetIdleTimer)
        );

        document.addEventListener("DOMContentLoaded", () => {
            startPing();
            resetIdleTimer();
        });




        $(document).ready(function () {
            $('#globalSearchInput').on('keyup', function () {
                var query = $(this).val().trim();
                if (query.length === 0) {
                    $('#globalSearchDropdown').hide();
                    return;
                }

                $.get('@Url.Action("AjaxSearch", "Search")', { query: query }, function (data) {
                    $('#searchResults').html(data);
                    $('#globalSearchDropdown').show();
                });
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('#globalSearchContainer').length) {
                    $('#globalSearchDropdown').hide();
                }
            });
        });


    </script>



    @RenderSection("scripts", required: false)

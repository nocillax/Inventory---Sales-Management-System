@model IEnumerable<inventory___sales_management_system.ViewModels.User.UserViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Users List";
    var nextSort = ViewBag.SortOrder == "asc" ? "desc" : "asc";
    string sortIcon = ViewBag.SortBy == "Username"
        ? (ViewBag.SortOrder == "asc" ? " ▲" : " ▼")
        : "";
}

<style>
    th.actions-column, td.actions-column {
        width: 150px;
        white-space: nowrap;
        text-align: center;
    }

    .clickable-row {
        cursor: pointer;
    }

    .clickable-row:hover {
        background-color: #f2f2f2;
    }

</style>

<h2 class="mb-4 text-primary" style="font-weight: bold">All Users</h2>

<div class="d-flex justify-content-evenly mb-3">
    <a href="@Url.Action("Create", "Users")" class="btn btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50"></i> New User
    </a>
</div>
<form method="get" class="form-inline mb-3">
    <label class="mr-2" for="roleFilter">Filter by Role:</label>
    @Html.DropDownList("roleFilter", (SelectList)ViewBag.RoleList, "All Roles", new
    {
        @class = "form-control mr-2",
        onchange = "this.form.submit();"
    })

    <input type="hidden" name="sortBy" value="@ViewBag.SortBy" />
    <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
</form>



<table class="table">
    <thead>
        <tr>
            <th>
                <a href="@Url.Action("Index", new {
                        sortBy = "Username",
                        sortOrder = ViewBag.SortBy == "Username" && ViewBag.SortOrder == "asc" ? "desc" : "asc",
                        page = 1,
                        roleFilter = ViewBag.RoleFilter
                    })">
                    @Html.DisplayNameFor(model => model.First().Username) @Html.Raw(sortIcon)
                </a>

            </th>
            <th>Email</th>
            <th>Role</th>
            <th class="actions-column">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No users found with that role.</td>
            </tr>
        }
        else
        {
            foreach (var user in Model)
            {
                <tr class="clickable-row" data-url="@Url.Action("Details", "Users", new { id = user.UserId })">

                    <td>@user.Username</td>
                    <td>@user.Email</td>
                    <td>@user.Role</td>

                    <td class="actions-column">
                        <div style="display: flex; gap: 10px; align-items: center; justify-content: center">

                            <a href="@Url.Action("Edit", "Users", new { id = user.UserId })" style="color: #4e73df" title="Edit">
                                <i class="fas fa-edit"></i>
                            </a>

                            @using (Html.BeginForm("Delete", "Users", new { id = user.UserId }, FormMethod.Post, new { onsubmit = "return confirmDelete();" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" style="color: #dc3545; border: none; background: none" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            }

                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        page = i,
                        sortBy = ViewBag.SortBy,
                        sortOrder = ViewBag.SortOrder,
                        roleFilter = ViewBag.RoleFilter
                    })">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm('Are you sure you want to delete this user?');
        }

        $(function () {
            var deleteMsg = '@TempData["DeleteMessage"]';
            var editMsg = '@TempData["EditMessage"]';
            var createMsg = '@TempData["CreateMessage"]';


            if (deleteMsg) {
                toastr.success(deleteMsg);
            }

            if (editMsg) {
                toastr.success(editMsg);
            }

            if (createMsg) {
                toastr.success(createMsg);
            }


            $('.clickable-row').on('click', function (e) {
                if (!$(e.target).is('a, button, i')) {
                    window.location = $(this).data('url');
                }
            });
        });
    </script>
}
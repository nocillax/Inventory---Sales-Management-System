@model IEnumerable<inventory___sales_management_system.Models.User>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Users List";
}

<h2>Users</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>@user.Role.ToString()</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = user.UserId }, new { @class = "btn btn-sm btn-primary" })

                    @using (Html.BeginForm("Delete", "Users", new { id = user.UserId }, FormMethod.Post, new { onsubmit = "return confirmDelete();" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.ActionLink("Create New User", "Create", "Users", null, new { @class = "btn btn-success" })

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm('Are you sure you want to delete this user?');
        }

        $(function() {
            var message = '@TempData["DeleteMessage"]';
            if (message) {
                toastr.success(message);
            }
        });
    </script>
}

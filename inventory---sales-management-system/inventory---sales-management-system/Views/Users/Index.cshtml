@model IEnumerable<inventory___sales_management_system.Models.User>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Users List";
}

<style>
    th.actions-column, td.actions-column {
        width: 150px; /* or desired fixed width */
        white-space: nowrap; /* prevent wrapping */
        text-align: center;
    }
</style>

<h2 class="mb-4 text-primary" style="font-weight: bold">All Users</h2>

<p>@Html.ActionLink("Create New User", "Create", "Users", null, new { @class = "btn btn-primary" })</p>

<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th class="actions-column">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.Email</td>
                <td>@user.Role.ToString()</td>

                <td class="actions-column">
                    <div style="display: flex; gap: 10px; align-items: center; justify-content: flex-end">

                        @Html.ActionLink("Edit", "Edit", new { id = user.UserId }) |

                        @using (Html.BeginForm("Delete", "Users", new { id = user.UserId }, FormMethod.Post, new { onsubmit = "return confirmDelete();" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link p-0 align-baseline" style="color: #dc3545;">
                                Delete
                            </button>
                        }

                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>


@section Scripts {
    <script>
        function confirmDelete() {
            return confirm('Are you sure you want to delete this user?');
        }

        $(function() {
            var message = '@TempData["DeleteMessage"]';
            if (message) {
                toastr.success(message);
            }
        });
    </script>
}
